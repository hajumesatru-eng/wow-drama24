---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Navbar from '../../../../components/Navbar.astro';
import DramaCard from '../../../../components/DramaCard.astro';

import dramas from '../../../../data/dramas.json';
import { categories } from '../../../../data/categories';

export async function getStaticPaths() {
  const PER_PAGE = 10;
  const paths = [];

  for (const category of categories) {
    const filtered = dramas.filter((d) =>
      category.slug === 'the-series-all'
        ? true
        : d.category === category.slug
    );

    const totalPages = Math.ceil(filtered.length / PER_PAGE);

    for (let page = 1; page <= totalPages; page++) {
      paths.push({
        params: {
          slug: category.slug,
          page: page.toString(),
        },
        props: {
          category,
          page,
          totalPages,
          dramasPage: filtered.slice(
            (page - 1) * PER_PAGE,
            page * PER_PAGE
          ),
        },
      });
    }
  }

  return paths;
}

const { category, page, totalPages, dramasPage } = Astro.props;
---

<BaseLayout
  title={`${category.name} - Page ${page}`}
  description={category.description}
>
  <Navbar />

  <section class="category-hero">
    <h1>{category.name}</h1>
    <p>{category.description}</p>
  </section>

  <section class="category-content">
    <div class="drama-grid">
      {
        dramasPage.map((drama) => (
          <DramaCard drama={drama} />
        ))
      }
    </div>

    <div class="pagination">
      {
        page > 1 && (
          <a
            href={
              page === 2
                ? `/category/${category.slug}/`
                : `/category/${category.slug}/page/${page - 1}/`
            }
          >
            ← Previous
          </a>
        )
      }

      <span>
        Page {page} of {totalPages}
      </span>

      {
        page < totalPages && (
          <a href={`/category/${category.slug}/page/${page + 1}/`}>
            Next →
          </a>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
.category-hero{
  text-align:center;
  padding:80px 20px 40px;
}

.category-hero h1{
  color:white;
  font-size:48px;
}

.category-hero p{
  color:#aaa;
  max-width:900px;
  margin:auto;
  line-height:1.8;
}

.category-content{
  max-width:1400px;
  margin:auto;
  padding:20px 20px 80px;
}

.drama-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
  gap:25px;
}

.pagination{
  display:flex;
  justify-content:center;
  align-items:center;
  gap:20px;
  margin-top:50px;
}

.pagination a{
  background:#e50914;
  color:white;
  text-decoration:none;
  padding:10px 18px;
  border-radius:6px;
}

.pagination span{
  color:white;
}
</style>