---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Navbar from '../../../../components/Navbar.astro';
import DramaCard from '../../../../components/DramaCard.astro';
import { supabase } from '../../../../lib/supabase.js';
import { categories } from '../../../../data/categories';

export const prerender = false;

const PER_PAGE = 10;

const slug = Astro.params.slug ?? "";
const page = Math.max(
  1,
  Number(Astro.params.page || 1)
);

// FIX TYPE SAFE CATEGORY
const category =
  categories.find((c) => c.slug === slug) || {
    slug,
    name: slug,
    title: slug,
    description: ""
  };

let query = supabase
  .from("dramas")
  .select("*", { count: "exact" });

if (slug !== "the-series-all") {
  query = query.eq("category", slug);
}

const from = (page - 1) * PER_PAGE;
const to = from + PER_PAGE - 1;

const {
  data,
  count,
  error
} = await query
  .order("created_at", { ascending: false })
  .range(from, to);

if (error) {
  console.error("Category Query Error:", error);
}

const dramasPage = data ?? [];
const totalItems = count ?? 0;

const totalPages = Math.max(
  1,
  Math.ceil(totalItems / PER_PAGE)
);

const hasPrev = page > 1;
const hasNext = page < totalPages;

const prevPage = page - 1;
const nextPage = page + 1;

// SEO SAFE
const pageTitle =
  page > 1
    ? `${category.title} - Page ${page}`
    : category.title;

const pageDescription =
  category.description ||
  `Watch ${category.name} dramas online`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>

<Navbar />

<section class="category-page">

  <div class="container">

    <div class="category-header">

      <h1>
        {category.name}
      </h1>

      {category.description && (
        <p class="description">
          {category.description}
        </p>
      )}

      <p class="total-count">
        Total: {totalItems} Dramas
      </p>

    </div>

    {dramasPage.length === 0 ? (
      <div class="empty-state">
        No dramas found.
      </div>
    ) : (
      <div class="grid">

        {dramasPage.map((drama) => (
          <DramaCard drama={drama} />
        ))}

      </div>
    )}

    {totalPages > 1 && (
      <div class="pagination">

        {hasPrev && (
          <a
            href={`/category/${slug}/page/${prevPage}`}
            class="page-btn"
          >
            ← Previous
          </a>
        )}

        <span class="page-info">
          Page {page} of {totalPages}
        </span>

        {hasNext && (
          <a
            href={`/category/${slug}/page/${nextPage}`}
            class="page-btn"
          >
            Next →
          </a>
        )}

      </div>
    )}

  </div>

</section>

</BaseLayout>

<style>
.category-page{
  padding:20px;
}

.container{
  max-width:1200px;
  margin:auto;
}

.category-header{
  margin-bottom:25px;
}

.category-header h1{
  font-size:32px;
  line-height:1.3;
  margin-bottom:12px;
}

.description{
  color:#aaa;
  line-height:1.8;
  margin-bottom:12px;
}

.total-count{
  color:#888;
  font-size:14px;
}

.grid{
  display:grid;
  grid-template-columns:
    repeat(auto-fill,minmax(180px,1fr));
  gap:20px;
}

.pagination{
  display:flex;
  justify-content:center;
  align-items:center;
  gap:15px;
  margin-top:40px;
  flex-wrap:wrap;
}

.page-btn{
  padding:10px 16px;
  background:#e50914;
  color:white;
  text-decoration:none;
  border-radius:6px;
}

.page-btn:hover{
  opacity:.9;
}

.page-info{
  color:#aaa;
}

.empty-state{
  text-align:center;
  padding:50px 20px;
  color:#999;
}

/* MOBILE */
@media(max-width:768px){

  .category-page{
    padding:15px;
  }

  .category-header h1{
    font-size:24px;
    line-height:1.4;
  }

  .description{
    font-size:14px;
    line-height:1.8;
  }

  .grid{
    grid-template-columns:
      repeat(2,1fr);
    gap:12px;
  }

  .page-btn{
    padding:8px 14px;
    font-size:14px;
  }

  .page-info{
    width:100%;
    text-align:center;
  }
}
</style>