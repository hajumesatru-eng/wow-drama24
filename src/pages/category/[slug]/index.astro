---
export const prerender = false;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import DramaCard from '../../../components/DramaCard.astro';

import { supabase } from '../../../lib/supabase';
import { categories } from '../../../data/categories.js';

const slug = Astro.params.slug;

// Cari kategori dari URL, fallback ke kategori pertama jika tidak ditemukan
const category = categories.find((c) => c.slug === slug) || categories[0];

// Ambil semua drama
const { data } = await supabase
  .from('dramas')
  .select('*')
  .order('created_at', { ascending: false });

const dramas = data || [];

// Logika Filter yang diperbarui
const filteredDramas = dramas.filter((drama) => {
  if (category.slug === 'the-series-all') {
    return true;
  }

  // Memastikan kolom 'categories' dipecah menjadi array dan dibersihkan dari spasi
  const dramaCategories = drama.categories 
    ? drama.categories.split(',').map((c: string) => c.trim()) 
    : [];

  return dramaCategories.includes(category.slug);
});

const PER_PAGE = 10;
const totalPages = Math.ceil(filteredDramas.length / PER_PAGE);
const firstPage = filteredDramas.slice(0, PER_PAGE);
---

<BaseLayout
  title={category.title}
  description={category.description}
>

  <Navbar />

  <section class="category-hero">
    <h1>{category.name}</h1>
    <p>{category.description}</p>
  </section>

  <section class="category-content">
    {
      firstPage.length > 0 ? (
        <div class="drama-grid">
          {firstPage.map((drama) => (
            <DramaCard drama={drama} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          No dramas available in this category.
        </div>
      )
    }

    {
      totalPages > 1 && (
        <div class="pagination">
          <a href={`/category/${category.slug}/page/2`}>
            Next →
          </a>
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .category-hero { text-align: center; padding: 80px 20px 40px; }
  .category-hero h1 { color: white; font-size: 48px; }
  .category-hero p { color: #aaa; max-width: 900px; margin: auto; line-height: 1.8; }
  .category-content { max-width: 1400px; margin: auto; padding: 20px 20px 80px; }
  .drama-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 25px; }
  .pagination { display: flex; justify-content: center; margin-top: 40px; }
  .pagination a { padding: 12px 20px; border-radius: 8px; text-decoration: none; color: white; background: #e50914; }
  .empty-state { text-align: center; color: #aaa; padding: 60px 20px; }

  @media (max-width: 768px) {
    .category-hero { padding: 60px 15px 30px; }
    .category-hero h1 { font-size: 32px; }
    .drama-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  }
</style>