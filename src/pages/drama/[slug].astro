---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import DramaCard from "../../components/DramaCard.astro";
import { supabase } from "../../lib/supabase.js";

const slug = Astro.params.slug;

// =======================
// DRAMA FROM SUPABASE
// =======================
const { data: drama } = await supabase
  .from("dramas")
  .select("*")
  .eq("slug", slug)
  .single();

if (!drama) {
  return new Response("Drama not found", { status: 404 });
}

// =======================
// EPISODES FROM SUPABASE
// =======================
const { data: episodes } = await supabase
  .from("episodes")
  .select("*")
  .eq("drama_slug", slug)
  .order("episode_number", { ascending: true });

// =======================
// RELATED DRAMAS FROM SUPABASE
// =======================
const { data: related } = await supabase
  .from("dramas")
  .select("*")
  .neq("slug", slug)
  .limit(6);

// fallback description
const description = drama.overview || drama.title;
const metaTitle =
  `ดูซีรี่ส์จีน ${drama.title} (${drama.year})` +
  (drama.title_th ? ` ${drama.title_th}` : "") +
  ` พากย์ไทย (เต็มเรื่อง)`;
---

<BaseLayout
  title={metaTitle}
  description={description}
  image={drama.poster}
  canonical={`https://wowdrama24.is-cool.dev/drama/${drama.slug}/`}
/>

<Navbar />

<!-- SEO Schema -->
<script type="application/ld+json">
  {JSON.stringify({
    "@context": "https://schema.org",
    "@type": "TVSeries",
    "name": drama.title,
    "alternateName": drama.title_th,
    "description": description,
    "url": `https://wowdrama24.is-cool.dev/drama/${drama.slug}`,
    "image": {
      "@type": "ImageObject",
      "url": drama.poster,
      "caption": drama.title
    },
    "genre": drama.category || "Drama",
    "inLanguage": "th",
    "publisher": {
      "@type": "Organization",
      "name": "WOW-DRAMA24"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://wowdrama24.is-cool.dev/drama/${drama.slug}`
    }
  })}
</script>

<!-- CONTENT -->
<section class="drama-detail">
  <div class="container">

    <div class="poster">
      <img src={drama.poster} alt={drama.title} />
    </div>

    <div class="info">
      <h1>{drama.title}</h1>

      {drama.title_th && <h2>{drama.title_th}</h2>}

      <p class="desc">{description}</p>

      <p><strong>Year:</strong> {drama.year}</p>

      <!-- FIX genre tampil lebih aman -->
      <p><strong>Category:</strong> {drama.genre?.join(", ")}</p>

      <a class="watch-btn" href={`/${drama.slug}`}>
        ▶ รับชมทุกตอน
      </a>
    </div>

  </div>
</section>

<!-- EPISODES PREVIEW (OPTIONAL SAFE) -->
<section class="episodes">
  <h2>Episodes</h2>

  {episodes?.length === 0 && <p>No episodes yet</p>}

  <ul>
    {episodes?.map((ep) => (
      <li>
        Episode {ep.episode_number}
      </li>
    ))}
  </ul>
</section>

<!-- RELATED -->
<section class="related">
  <h2>ซีรีส์เพิ่มเติม</h2>

  <div class="grid">
    {related?.map((item) => (
      <DramaCard drama={item} />
    ))}
  </div>
</section>

</BaseLayout>

<style>
.drama-detail{
  padding:60px 20px;
  color:white;
}

.container{
  display:flex;
  gap:40px;
  max-width:1100px;
  margin:auto;
}

.poster img{
  width:300px;
  border-radius:12px;
}

.info h1{
  font-size:36px;
  margin-bottom:10px;
}

.info h2{
  font-size:20px;
  color:#aaa;
}

.desc{
  margin:20px 0;
  color:#ccc;
  line-height:1.8;
}

.watch-btn{
  display:inline-block;
  padding:12px 20px;
  background:red;
  color:white;
  border-radius:8px;
  margin-top:20px;
  text-decoration:none;
}

.related{
  max-width:1200px;
  margin:auto;
  padding:40px 20px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(200px,1fr));
  gap:20px;
}

@media(max-width:768px){
  .container{
    flex-direction:column;
  }

  .poster img{
    width:100%;
  }
}
</style>