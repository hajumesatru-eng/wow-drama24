---
export const prerender = false;
import { supabase } from "../../lib/supabase";
import { parse } from "cookie";

const cookies = parse(Astro.request.headers.get("cookie") || "");
const isLoggedIn = cookies.admin_token === "logged-in";

if (!isLoggedIn) {
  return Astro.redirect("/admin/login");
}

const { data: dramas } = await supabase
  .from("dramas")
  .select("*")
  .order("id", { ascending: false });
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Admin Dashboard</title>

  <style>
    body {
      font-family: Arial;
      background: #111;
      color: #fff;
      padding: 20px;
    }

    .card {
      background: #1c1c1c;
      padding: 15px;
      margin-bottom: 10px;
      display: flex;
      justify-content: space-between;
      border-radius: 8px;
    }

    button {
      margin-left: 5px;
      padding: 6px 10px;
      border: none;
      cursor: pointer;
    }

    .del { background: red; color: white; }
    .edit { background: orange; color: black; }
    .toggle { background: green; color: white; }
  </style>
</head>

<body>

<h2>🎬 Admin Dashboard</h2>

{(dramas || []).map((d) => (
  <div class="card">
    <div>
      <b>{d.title}</b><br />
      Episode: {d.episodes ?? 0}<br />
      Status: <b>{d.status ?? "draft"}</b>
    </div>

    <div>
      <button class="toggle"
        onclick={`toggleStatus(${d.id}, '${d.status ?? "draft"}')`}
      >
        {d.status === "published" ? "Unpublish" : "Publish"}
      </button>

      <button class="edit"
        onclick={`updateEpisode(${d.id})`}
      >
        ✏️
      </button>

      <button class="del"
        onclick={`deleteDrama(${d.id})`}
      >
        ❌
      </button>
    </div>
  </div>
))}

<!-- 🔥 FIX: pakai window.* biar tidak kena TS error Astro -->
<script is:inline>
  window.toggleStatus = async (id, currentStatus) => {
    const newStatus = currentStatus === "published" ? "draft" : "published";

    await fetch("/api/update-status", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id, status: newStatus }),
    });

    location.reload();
  };

  window.updateEpisode = async (id) => {
    const ep = prompt("Masukkan episode:");
    if (!ep) return;

    await fetch("/api/update-episode", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id, episodes: Number(ep) }),
    });

    location.reload();
  };

  window.deleteDrama = async (id) => {
    if (!confirm("Hapus drama?")) return;

    await fetch("/api/delete-drama", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id }),
    });

    location.reload();
  };
</script>

</body>
</html>