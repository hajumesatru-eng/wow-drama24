---
export const prerender = false;
import { supabase } from "../../lib/supabase";

// Mengambil token dari cookie
const accessToken = Astro.cookies.get("sb-access-token")?.value;

// Jika tidak ada token, paksa ke login
if (!accessToken) {
  return Astro.redirect("/admin/login");
}

const { data: dramas } = await supabase
  .from("dramas")
  .select("*")
  .order("id", { ascending: false });
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Admin Dashboard</title>
  <style>
    body { font-family: Arial; background: #111; color: #fff; padding: 20px; }
    .card { background: #1c1c1c; padding: 15px; margin-bottom: 10px; display: flex; justify-content: space-between; border-radius: 8px; }
    button { margin-left: 5px; padding: 6px 10px; border: none; cursor: pointer; }
    .del { background: red; color: white; }
    .edit { background: orange; color: black; }
    .toggle { background: green; color: white; }
  </style>
</head>
<body>
  <h2>🎬 Admin Dashboard</h2>
  {(dramas || []).map((d) => (
    <div class="card">
      <div>
        <b>{d.title}</b><br />
        Episode: {d.episodes ?? 0}<br />
        Status: <b>{d.status ?? "draft"}</b>
      </div>
      <div>
        <button class="toggle" onclick={`toggleStatus(${d.id}, '${d.status ?? "draft"}')`}>
          {d.status === "published" ? "Unpublish" : "Publish"}
        </button>
        <button class="edit" onclick={`updateEpisode(${d.id})`}>✏️</button>
        <button class="del" onclick={`deleteDrama(${d.id})`}>❌</button>
      </div>
    </div>
  ))}

  <script is:inline>
    // Fungsi-fungsi tetap sama seperti milik Anda sebelumnya...
    window.toggleStatus = async (id, status) => { /* ... fetch api ... */ location.reload(); };
    window.updateEpisode = async (id) => { /* ... fetch api ... */ location.reload(); };
    window.deleteDrama = async (id) => { /* ... fetch api ... */ location.reload(); };
  </script>
</body>
</html>