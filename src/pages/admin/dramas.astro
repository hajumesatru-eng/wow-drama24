---
export const prerender = false;
import { supabase } from "../../lib/supabase.js";

const { data: dramas } = await supabase
  .from("dramas")
  .select("*")
  .order("id", { ascending: false });
---

<html>
<head>
  <title>Admin Dramas</title>

  <style>
    body { font-family: Arial; background: #111; color: #fff; padding: 20px; }
    .card { background: #1c1c1c; padding: 15px; margin-bottom: 10px; display: flex; justify-content: space-between; border-radius: 8px; }
    button { margin-left: 5px; padding: 6px 10px; border: none; cursor: pointer; }
    .del { background: red; color: white; }
    .edit { background: orange; color: black; }
    .toggle { background: green; color: white; }
  </style>
</head>

<body>

<h1>🎬 Netflix Admin (Dramas)</h1>

<a class="btn" href={`/admin/add-drama`}> + Add Drama</a>
<hr />

<div class="grid">
  {dramas?.map((d) => (
    <div class="card">

      <img src={d.poster || "https://via.placeholder.com/300"} />

      <h3 style="font-size:14px;">
        {d.title}
      </h3>

      <small>{d.year || "—"}</small>       
      <div>
        <a class="btn" href={`/admin/drama/${d.id}`}> Edit</a>
        <a class="btn" href={`/drama/${d.slug}`}>View</a>
        <button class="btn" onclick={`deleteDrama(${d.id})`}>Delete</button>
      </div>

    </div>
  ))}
</div>

<script is:inline>
window.deleteDrama = async (id) => {
  if (!confirm("Delete this drama?")) return;

  const res = await fetch("/api/delete-drama", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ id })
  });

  const data = await res.json();

  if (data.success) location.reload();
  else alert("Failed");
};
</script>

</body>
</html>