---
// Perbaikan: Path import disesuaikan (naik 2 level ke 'src')
// Jika Anda menggunakan alias @lib/supabase, Anda bisa menggantinya dengan "@lib/supabase"
import { supabase } from "../../lib/supabase";

const { data: dramas } = await supabase
  .from("dramas")
  .select("*")
  .order("id", { ascending: false });
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dramas | Dashboard</title>

  <style>
    :root { --primary: #e50914; --dark: #111; --card: #1c1c1c; }
    body { font-family: 'Segoe UI', sans-serif; background: var(--dark); color: #fff; padding: 40px; margin: 0; }
    
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
    .btn { background: var(--primary); color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; font-weight: bold; border: none; cursor: pointer; transition: 0.2s; }
    .btn:hover { opacity: 0.8; }

    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 25px; }
    
    .card { background: var(--card); border-radius: 12px; overflow: hidden; transition: transform 0.3s; padding: 15px; border: 1px solid #333; }
    .card:hover { transform: scale(1.03); border-color: var(--primary); }
    
    .card img { width: 100%; height: 350px; object-fit: cover; border-radius: 8px; margin-bottom: 15px; }
    
    .card h3 { margin: 0 0 10px 0; font-size: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .actions { display: flex; gap: 10px; margin-top: 15px; }
    .actions a, .actions button { flex: 1; text-align: center; padding: 8px; border-radius: 4px; font-size: 13px; }
    
    .del { background: #555; }
    .del:hover { background: #d00; }
  </style>
</head>

<body>

<div class="header">
  <h1>Admin Dramas</h1>
  <a class="btn" href="/admin/add-drama">+ Add New Drama</a>
</div>

<div class="grid">
  {dramas?.map((d: any) => (
    <div class="card">
      <img src={d.poster || "https://via.placeholder.com/300x450"} alt={d.title} />
      <h3>{d.title}</h3>
      <small style="color: #aaa;">{d.year || "N/A"}</small>
      
      <div class="actions">
        <a class="btn" href={`/admin/drama/${d.id}`}>Edit</a>
        <a class="btn" style="background:#333;" href={`/drama/${d.slug}`}>View</a>
        <button class="btn del" onclick={`deleteDrama(${d.id})`}>Delete</button>
      </div>
    </div>
  ))}
</div>

<script is:inline>
window.deleteDrama = async (id) => {
  if (!confirm("Hapus drama ini?")) return;

  const res = await fetch("/api/delete-drama", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ id })
  });

  const data = await res.json();
  if (data.success) {
    location.reload();
  } else {
    alert("Gagal menghapus drama");
  }
};
</script>

</body>
</html>