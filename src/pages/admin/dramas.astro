---
import { supabase } from "../../lib/supabase.js";

const { data: dramas } = await supabase
  .from("dramas")
  .select("*")
  .order("id", { ascending: false });
---

<html>
<head>
  <title>Admin Dramas</title>

  <style>
    body {
  background: #0b0b0b;
  color: white;
  font-family: Arial;
  }

    h1 {
  font-size: 22px;
  }

   .grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 15px;
  }

   .card {
  background: #141414;
  border-radius: 10px;
  overflow: hidden;
  transition: 0.2s;
  }

   .card:hover {
  transform: scale(1.05);
  }

   .card img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  }

   .btn {
  font-size: 12px;
  padding: 4px 6px;
  margin: 3px;
  background: #222;
  color: white;
  border: none;
  cursor: pointer;
  }
    
  </style>
</head>

<body>

<h1>🎬 Netflix Admin (Dramas)</h1>

<a href="/admin/add-drama">+ Add Drama</a>

<hr />

<div class="grid">
  {dramas?.map((d) => (
    <div class="card">

      <img src={d.poster || "https://via.placeholder.com/300"} />

      <h3 style="font-size:14px;">
        {d.title}
      </h3>

      <small>{d.year || "—"}</small>       
      <div>
        <a class="btn" href={`/admin/drama/${d.id}`}> Edit</a>
        <a class="btn" href={`/drama/${d.slug}`}>View</a>
        <button class="btn" onclick={`deleteDrama(${d.id})`}>Delete</button>
      </div>

    </div>
  ))}
</div>

<script is:inline>
window.deleteDrama = async (id) => {
  if (!confirm("Delete this drama?")) return;

  const res = await fetch("/api/delete-drama", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ id })
  });

  const data = await res.json();

  if (data.success) location.reload();
  else alert("Failed");
};
</script>

</body>
</html>