---
export const prerender = false;
import { supabase } from "../../../lib/supabase";

// Mengambil data kategori
import { categories } from "../../../data/categories.js";

const { id } = Astro.params;

// 1. Ambil data drama
const { data: drama } = await supabase
  .from("dramas")
  .select("*")
  .eq("id", id)
  .single();

if (!drama) return new Response("Drama not found", { status: 404 });

// 2. Ambil data episodes
const { data: episodes } = await supabase
  .from("episodes")
  .select("*")
  .eq("drama_slug", drama.slug)
  .order("episode_number", { ascending: true });

// Memisahkan string kategori menjadi array untuk checkbox
const currentCategories = drama.category ? drama.category.split(",").map((c: any) => c.trim()) : [];
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <title>Edit Drama - {drama.title}</title>
  <style>
    body { font-family: sans-serif; padding: 20px; background: #111; color: #fff; }
    input, textarea { width: 100%; padding: 8px; margin: 10px 0; color: #000; }
    .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin: 10px 0; background: #222; padding: 15px; border-radius: 5px; }
    .cat-item { display: flex; align-items: center; gap: 8px; cursor: pointer; color: #fff; }
    .episode-box { background: #222; padding: 10px; margin: 10px 0; border-radius: 5px; }
    button { padding: 10px 20px; cursor: pointer; background: #e50914; color: white; border: none; border-radius: 4px; }
  </style>
</head>

<body>
  <h1>✏️ Edit Drama: {drama.title}</h1>

  <input id="title" value={drama.title || ""} placeholder="Title" />
  <input id="slug" value={drama.slug || ""} placeholder="Slug" />
  <input id="poster" value={drama.poster || ""} placeholder="Poster URL" />
  
  <h3>Pilih Kategori:</h3>
  <div class="cat-grid" id="cat-container">
    {categories.map((cat: any) => (
      <label class="cat-item">
        <input type="checkbox" value={cat.slug} checked={currentCategories.includes(cat.slug)} />
        {cat.name}
      </label>
    ))}
  </div>

  <button onclick="saveDrama()">💾 Save Drama</button>
  <p id="statusText"></p>

  <hr />

  <h2>🎬 Episodes</h2>
  <div style="margin-top: 20px;">
    {episodes?.length === 0 && <p>No episodes yet</p>}
    {episodes?.map((ep: any) => (
      <div class="episode-box">
        <h4>Episode {ep.episode_number}</h4>
        <input id={`ep-${ep.id}`} value={ep.video_url || ""} placeholder="Video URL" />
        <button onclick={`saveEpisode(${ep.id})`}>💾 Save Episode</button>
      </div>
    ))}
  </div>

  <script is:inline define:vars={{ dramaId: id }}>
    async function saveDrama() {
      const selectedCats = Array.from(document.querySelectorAll('#cat-container input:checked'))
                                .map(cb => cb.value)
                                .join(', ');

      const payload = {
        id: Number(dramaId),
        title: document.getElementById("title").value,
        slug: document.getElementById("slug").value,
        poster: document.getElementById("poster").value,
        category: selectedCats
      };

      const res = await fetch("/api/save-drama", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      const data = await res.json();
      document.getElementById("statusText").innerText = data.success ? "✅ Saved!" : "❌ Error: " + data.error;
    }

    window.saveEpisode = async function (id) {
      const video_url = document.getElementById(`ep-${id}`).value;
      const res = await fetch("/api/update-episode", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id, video_url })
      });
      const data = await res.json();
      alert(data.success ? "Episode saved!" : data.error);
    };
  </script>
</body>
</html>