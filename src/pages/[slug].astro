<!-- PLAYER SCRIPT (UNCHANGED LOGIC) -->
<script is:inline>
  const player = document.getElementById("videoPlayer");

  document.querySelectorAll(".ep-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const url = btn.getAttribute("data-url");
      if (player && url) {
        player.src = url;
      }
    });
  });
</script>

<!-- STYLES (UNCHANGED) -->
<style>
.container {
  max-width: 1100px;
  margin: auto;
  padding: 20px;
}

.backdrop img {
  width: 100%;
  height: 300px;
  object-fit: cover;
  border-radius: 10px;
}

.info {
  display: flex;
  gap: 20px;
  margin-top: 20px;
  align-items: flex-start;
}

.poster {
  width: 180px;
  border-radius: 10px;
  flex-shrink: 0;
}

.info div {
  flex: 1;
}

.player {
  width: 100%;
  margin-top: 20px;
  aspect-ratio: 16 / 9;
}

.player iframe {
  width: 100%;
  height: 100%;
  border: none;
  border-radius: 10px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
  gap: 10px;
}

.ep-btn {
  padding: 10px;
  background: #222;
  color: #fff;
  border: none;
  border-radius: 6px;
  cursor: pointer;
}

.ep-btn:hover {
  background: #444;
}

.ad-top,
.ad-middle {
  display: flex;
  justify-content: center;
  margin: 25px 0;
}

.telegram-box {
  margin: 30px auto;
  padding: 30px 20px;
  background: #161616;
  border-radius: 16px;
  text-align: center;
  border: 1px solid #222;
}

.telegram-box p {
  color: #ccc;
  font-size: 18px;
  margin-bottom: 20px;
}

.telegram-btn {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  height: 52px;
  padding: 0 30px;
  background: #229ED9;
  color: #fff;
  border-radius: 12px;
  font-weight: 700;
  text-decoration: none;
}

.floating-left,
.floating-right {
  position: fixed;
  top: 120px;
  z-index: 50;
}

.floating-left { left: 10px; }
.floating-right { right: 10px; }

@media (max-width: 768px) {

  .container {
    padding: 12px;
  }

  .info {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .poster {
    width: 60%;
    max-width: 220px;
  }

  .backdrop img {
    height: 180px;
  }

  .info h1 {
    font-size: 18px;
  }

  .info p {
    font-size: 13px;
  }

  .grid {
    grid-template-columns: repeat(5, 1fr);
  }

  .floating-left,
  .floating-right {
    display: none;
  }

  body {
    padding-bottom: 70px;
  }
}
.bottom-ad-center {
  display: flex;
  justify-content: center;
  margin: 20px 0;
}
.mobile-sticky-ad-center {
  display: flex;
  justify-content: center;
  margin: 20px 0;
}
</style>

