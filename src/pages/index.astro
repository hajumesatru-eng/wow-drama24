---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import SearchBox from "../components/SearchBox.astro";
import DramaCard from "../components/DramaCard.astro";
import dramas from "../data/dramas.json";

const PER_PAGE = 15;
const latest = dramas.slice(0, PER_PAGE);
---

<BaseLayout
  title="Wow-Drama24 ดูซีรี่ย์จีนพากย์ไทย | เว็บดูซีรี่ย์ออนไลน์ฟรี HD"
  description="เว็บดูซีรี่ย์จีนพากย์ไทยและซับไทยครบทุกความสนุก รวมซีรี่ย์ใหม่ล่าสุดให้รับชมฟรีในคุณภาพระดับ HD มีทั้งซีรี่ย์เกาหลี ละครไทย และซีรี่ย์จากหลากหลายประเทศ อัปเดตใหม่ทุกวัน ดูง่ายไม่มีค่าใช้จ่าย รองรับการดูบนมือถือและคอมพิวเตอร์ เพลิดเพลินไปกับซีรี่ย์ที่คุณชื่นชอบได้ทุกที่ทุกเวลา"
  canonical="https://wow-drama24.page.dev/"
>
<div class="container">
<Navbar />
<SearchBox />

<!-- HERO SEO -->
<section class="hero">
  <h1>ดูซีรี่ย์จีนพากย์ไทย | เว็บดูซีรี่ย์ออนไลน์คุณภาพ</h1>

  <p>
    หากคุณกำลังมองหาแหล่ง ดูซีรี่ย์จีนพากย์ไทย ที่ครบครันและอัปเดตตลอดเวลา WOW-DRAMA24 คือคำตอบ! เราได้รวบรวมซีรี่ย์ใหม่ๆ จากเอเชียมาไว้ที่นี่ ไม่ว่าจะเป็น ดูซีรี่ย์จีนพากย์ไทย, ดูซีรี่ย์จีนซับไทย, ละครไทยย้อนหลัง (ซีรี่ย์ไทย), รวมถึง ซีรี่ย์เกาหลี และซีรี่ย์ฮิตเรื่องใหม่ๆ ที่มาแรงในขณะนี้
  </p>

  <a href="/page/1" class="cta">
    ดูซีรี่ย์ทั้งหมด →
  </a>
</section>

<!-- LATEST -->
<section class="latest-section">

  <h2>🔥 ซีรี่ย์แนะนำล่าสุด</h2>

  <div class="drama-grid">
    {latest.map((drama) => (
      <DramaCard drama={drama} />
    ))}
  </div>

</section>

<!-- SEO INTERNAL LINK BLOCK -->
<section class="seo-links">
  <h2>ดูซีรี่ย์ยอดนิยม</h2>

  <ul>
    <li><a href="/page/1">ซีรี่ย์ทั้งหมด (Page 1)</a></li>
    <li><a href="/page/2">ซีรี่ย์มาใหม่</a></li>
  </ul>
</section>
<section class="seo-content">

  <h2>
    ดูซีรี่ย์จีนพากย์ไทย ดูซีรี่ย์ออนไลน์ฟรี HD ครบทุกความสนุก
  </h2>

  <p>
    ในยุคดิจิทัลปัจจุบัน การดูซีรี่ย์ออนไลน์กลายเป็นกิจกรรมที่หลายคนชื่นชอบ เนื่องจากความสะดวกสบายที่สามารถรับชมได้ทุกที่ทุกเวลา ไม่ต้องรอฉายทางโทรทัศน์อีกต่อไป และที่ WOW-DRAMA24 คุณสามารถเพลิดเพลินไปกับซีรี่ย์ที่หลากหลายจากหลายประเทศ รวมถึงการ ดูซีรี่ย์จีน ดูซีรี่ส์เกาหลี ดูซีรี่ย์จีนพากย์ไทย ดูซีรีส์ญี่ปุ่น ได้ทั้งแบบพากย์ไทยและซับไทย รวมไปถึง ละครไทยย้อนหลัง ซึ่งทั้งหมดนี้สามารถรับชมได้โดยไม่มีโฆษณาคั่น สร้างความสนุกสนานแบบไม่ขาดตอน
  </p>

  <p>
    ซีรี่ย์มาใหม่ สำหรับคนที่ชอบ ดูซีรี่ย์จีนพากย์ไทย หรือคอซีรี่ย์จีนที่ต้องการดื่มด่ำกับเรื่องราวอันน่าประทับใจ WOW-DRAMA24 มีให้คุณเลือกชมหลากหลายประเภท ไม่ว่าจะเป็นซีรี่ย์ประวัติศาสตร์ ซีรี่ย์แนวโรแมนติก หรือซีรี่ย์แนวแอ็คชั่นที่กำลังเป็นที่นิยม ได้รวบรวมจากทุกแพลตฟอร์ม เช่น Netflix Viu Disney+ WeTV HBO iQiyi Monomax Youku และอื่นๆ ทั้งในรูปแบบพากย์ไทยและซับไทย คุณสามารถเลือกดูได้ตามความต้องการ ด้วยความคมชัดระดับ Full HD ที่รับรองว่าจะทำให้คุณเต็มอิ่มกับทุกฉากที่สำคัญ
  </p>

  <p>
    พร้อมดูซีรี่ย์แล้วหรือยัง? หากคุณพร้อมแล้ว เข้ามารับชม ดูซีรี่ย์จีนพากย์ไทย และซีรี่ย์อื่นๆ อีกมากมายได้ทันทีที่ WOW-DRAMA24 เราขอส่งมอบความสนุกแบบจัดเต็มให้คุณได้สัมผัสกับประสบการณ์ดูซีรี่ย์ออนไลน์ที่ดีที่สุด!
  </p>

</section>
<!-- JSON-LD SEO -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "WOW-DRAMA24",
  "url": "https://wow-drama24.page.dev/",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://wow-drama24.page.dev/?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
})} />
</div>
</BaseLayout>
<style>
  .hero{
  text-align:center;
  padding:60px 20px;
}

.hero h1{
  font-size:42px;
  margin-bottom:15px;
}

.hero p{
  max-width:700px;
  margin:auto;
  color:#bbb;
  line-height:1.6;
}

.cta{
  display:inline-block;
  margin-top:20px;
  padding:12px 20px;
  background:#e50914;
  color:white;
  border-radius:8px;
}
</style>