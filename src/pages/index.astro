---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import SearchBox from "../components/SearchBox.astro";
import DramaCard from "../components/DramaCard.astro";
import { supabase } from "../lib/supabase.js";
console.log("URL:", import.meta.env.PUBLIC_SUPABASE_URL);
console.log("KEY:", !!import.meta.env.PUBLIC_SUPABASE_ANON_KEY);

const PER_PAGE = 30;

const { data, count, error } = await supabase
  .from("dramas")
  .select("*", { count: "exact" })
  .order("created_at", { ascending: false })
  .range(0, PER_PAGE - 1);

console.log("SUPABASE DATA:", data);
console.log("SUPABASE ERROR:", error);

const latest = data || [];
const totalPages = Math.ceil((count || 0) / PER_PAGE);
---

<BaseLayout
  title="Wow-Drama24 ดูซีรี่ย์จีนพากย์ไทย | เว็บดูซีรี่ย์ออนไลน์ฟรี HD"
  description="เว็บดูซีรี่ย์จีนพากย์ไทยและซับไทยครบทุกความสนุก รวมซีรี่ย์ใหม่ล่าสุดให้รับชมฟรีในคุณภาพระดับ HD มีทั้งซีรี่ย์เกาหลี ละครไทย และซีรี่ย์จากหลากหลายประเทศ อัปเดตใหม่ทุกวัน ดูง่ายไม่มีค่าใช้จ่าย รองรับการดูบนมือถือและคอมพิวเตอร์ เพลิดเพลินไปกับซีรี่ย์ที่คุณชื่นชอบได้ทุกที่ทุกเวลา"
  canonical="https://wow-drama24.pages.dev/"
>
<div class="container">

<Navbar />
<SearchBox />

<!-- HERO SEO -->
<section class="hero">
  <h1>ดูซีรี่ย์จีนพากย์ไทย | เว็บดูซีรี่ย์ออนไลน์คุณภาพ</h1>

  <p>
    หากคุณกำลังมองหาแหล่ง ดูซีรี่ย์จีนพากย์ไทย ที่ครบครันและอัปเดตตลอดเวลา WOW-DRAMA24 คือคำตอบ! เราได้รวบรวมซีรี่ย์ใหม่ๆ จากเอเชียมาไว้ที่นี่ ไม่ว่าจะเป็น ดูซีรี่ย์จีนพากย์ไทย, ดูซีรี่ย์จีนซับไทย, ละครไทยย้อนหลัง (ซีรี่ย์ไทย), รวมถึง ซีรี่ย์เกาหลี และซีรี่ย์ฮิตเรื่องใหม่ๆ ที่มาแรงในขณะนี้
  </p>

  <a href="/page/1" class="cta">
    ดูซีรี่ย์ทั้งหมด →
  </a>
</section>

<!-- LATEST -->
<section class="latest-section">

  <h2>🔥 ซีรี่ย์แนะนำล่าสุด</h2>

  <div class="drama-grid">
    {latest.length > 0 ? (
      latest.map((drama) => (
        <DramaCard drama={drama} />
      ))
    ) : (
      <p style="color:#aaa">No data available</p>
    )}
  </div>

  {totalPages > 1 && (
    <div class="pagination">

      <span class="current">
        Page 1
      </span>

      {Array.from(
        { length: Math.min(totalPages, 10) },
        (_, i) => (
          <a href={`/page/${i + 1}`}>
            {i + 1}
          </a>
        )
      )}

      {totalPages > 1 && (
        <a href="/page/2">
          Next →
        </a>
      )}

    </div>
  )}

</section>

<!-- SEO INTERNAL LINK BLOCK -->
<section class="seo-links">
  <h2>ดูซีรี่ย์ยอดนิยม</h2>

  <ul>
    <li><a href="/page/1">ซีรี่ย์ทั้งหมด (Page 1)</a></li>
    <li><a href="/page/2">ซีรี่ย์มาใหม่</a></li>
  </ul>
</section>

<!-- SEO CONTENT (TIDAK DIUBAH) -->
<section class="seo-content">

  <h2>
    ดูซีรี่ย์จีนพากย์ไทย ดูซีรี่ย์ออนไลน์ฟรี HD ครบทุกความสนุก
  </h2>

  <p>
    ในยุคดิจิทัลปัจจุบัน การดูซีรี่ย์ออนไลน์กลายเป็นกิจกรรมที่หลายคนชื่นชอบ เนื่องจากความสะดวกสบายที่สามารถรับชมได้ทุกที่ทุกเวลา ไม่ต้องรอฉายทางโทรทัศน์อีกต่อไป และที่ WOW-DRAMA24 คุณสามารถเพลิดเพลินไปกับซีรี่ย์ที่หลากหลายจากหลายประเทศ รวมถึงการ ดูซีรี่ย์จีน ดูซีรี่ส์เกาหลี ดูซีรี่ย์จีนพากย์ไทย ดูซีรีส์ญี่ปุ่น ได้ทั้งแบบพากย์ไทยและซับไทย รวมไปถึง ละครไทยย้อนหลัง ซึ่งทั้งหมดนี้สามารถรับชมได้โดยไม่มีโฆษณาคั่น สร้างความสนุกสนานแบบไม่ขาดตอน
  </p>

  <p>
    ซีรี่ย์มาใหม่ สำหรับคนที่ชอบ ดูซีรี่ย์จีนพากย์ไทย หรือคอซีรี่ย์จีนที่ต้องการดื่มด่ำกับเรื่องราวอันน่าประทับใจ WOW-DRAMA24 มีให้คุณเลือกชมหลากหลายประเภท ไม่ว่าจะเป็นซีรี่ย์ประวัติศาสตร์ ซีรี่ย์แนวโรแมนติก หรือซีรี่ย์แนวแอ็คชั่นที่กำลังเป็นที่นิยม ได้รวบรวมจากทุกแพลตฟอร์ม เช่น Netflix Viu Disney+ WeTV HBO iQiyi Monomax Youku และอื่นๆ ทั้งในรูปแบบพากย์ไทยและซับไทย คุณสามารถเลือกดูได้ตามความต้องการ ด้วยความคมชัดระดับ Full HD ที่รับรองว่าจะทำให้คุณเต็มอิ่มกับทุกฉากที่สำคัญ
  </p>

  <p>
    พร้อมดูซีรี่ย์แล้วหรือยัง? หากคุณพร้อมแล้ว เข้ามารับชม ดูซีรี่ย์จีนพากย์ไทย และซีรี่ย์อื่นๆ อีกมากมายได้ทันทีที่ WOW-DRAMA24 เราขอส่งมอบความสนุกแบบจัดเต็มให้คุณได้สัมผัสกับประสบการณ์ดูซีรี่ย์ออนไลน์ที่ดีที่สุด!
  </p>

</section>

<!-- JSON-LD SEO -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "WOW-DRAMA24",
  "url": "https://wow-drama24.pages.dev/",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://wow-drama24.pages.dev/?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
})} />

</div>
</BaseLayout>

<style>
/* ❗ SEMUA STYLE TETAP (TIDAK DIUBAH) */
.hero{
  text-align:center;
  padding:60px 20px;
}

.hero h1{
  font-size:42px;
  margin-bottom:15px;
}

.hero p{
  max-width:700px;
  margin:auto;
  color:#bbb;
  line-height:1.6;
}

.cta{
  display:inline-block;
  margin-top:20px;
  padding:12px 20px;
  background:#e50914;
  color:white;
  border-radius:8px;
}

.container{
  max-width:1200px;
  margin:auto;
  padding:0 16px;
}

.latest-section{
  margin-top:40px;
}

.latest-section h2{
  margin-bottom:20px;
}

.drama-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(180px,1fr));
  gap:16px;
}

.seo-content{
  max-width:900px;
  margin:60px auto;
  line-height:1.9;
  color:#bbb;
}

.seo-content h2{
  color:#fff;
  margin-bottom:20px;
}

.seo-links{
  margin-top:40px;
}

.seo-links ul{
  padding-left:20px;
}

.seo-links li{
  margin-bottom:10px;
}

.pagination{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  align-items:center;
  gap:10px;
  margin-top:40px;
}

.pagination a,
.pagination span{
  padding:10px 16px;
  border-radius:8px;
  text-decoration:none;
}

.pagination a{
  background:#1f1f1f;
  color:white;
}

.pagination a:hover{
  background:#e50914;
}

.pagination .current{
  background:#e50914;
  color:white;
}
</style>