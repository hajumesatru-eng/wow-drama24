---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import SearchBox from "../components/SearchBox.astro";
import { supabase } from "../lib/supabase";

const url = new URL(Astro.request.url);

const q = url.searchParams.get("q")?.trim() || "";
const keyword = q.toLowerCase();

// Ambil semua drama dari Supabase
const { data: dramas } = await supabase
  .from("dramas")
  .select("*")
  .order("created_at", { ascending: false });

function similarity(a: string, b: string): number {
  a = a.toLowerCase();
  b = b.toLowerCase();

  let score = 0;

  for (let i = 0; i < Math.min(a.length, b.length); i++) {
    if (a[i] === b[i]) score++;
  }

  return score / Math.max(a.length || 1, b.length || 1);
}

const results =
  dramas?.filter((d) => {
    return (
      d.title?.toLowerCase().includes(keyword) ||
      d.title_th?.toLowerCase().includes(keyword) ||
      d.slug?.toLowerCase().includes(keyword)
    );
  }) || [];

const suggestions =
  dramas
    ?.map((d) => ({
      ...d,
      score: Math.max(
        similarity(keyword, d.title || ""),
        similarity(keyword, d.title_th || "")
      )
    }))
    .sort((a, b) => b.score - a.score)
    .slice(0, 5) || [];
---

<BaseLayout
  title={`Search: ${q} | WOW-DRAMA24`}
  description={`Search results for ${q}`}
>

<Navbar />

<SearchBox />

<section class="search-page">

  <h1>
    Search Results: "{q}"
  </h1>

  {results.length > 0 ? (

    <div class="grid">

      {results.map((d) => (

        <a
          href={`/drama/${d.slug}`}
          class="card"
        >

          <img
            src={d.poster || "/no-poster.jpg"}
            alt={d.title}
            loading="lazy"
          />

          <h3>{d.title}</h3>

          {d.title_th && (
            <p>{d.title_th}</p>
          )}

        </a>

      ))}

    </div>

  ) : (

    <div class="empty">

      <h2>
        ไม่พบผลลัพธ์สำหรับ "{q}"
      </h2>

      <p>
        ลองค้นหาด้วยคำอื่น หรือกลับไปหน้าแรก
      </p>

      <a href="/" class="home-btn">
        🏠 กลับหน้าแรก
      </a>

      {suggestions.length > 0 && (

        <>
          <p class="maybe">
            Maybe you mean:
          </p>

          <div class="suggestions">

            {suggestions.map((d) => (

              <a
                href={`/drama/${d.slug}`}
                class="suggestion-item"
              >

                <img
                  src={d.poster || "/no-poster.jpg"}
                  alt={d.title}
                  loading="lazy"
                />

                <div class="suggestion-content">

                  <strong>
                    {d.title}
                  </strong>

                  {d.title_th && (
                    <p>{d.title_th}</p>
                  )}

                </div>

              </a>

            ))}

          </div>

        </>

      )}

    </div>

  )}

</section>

</BaseLayout>

<style>

.search-page{
  max-width:1200px;
  margin:auto;
  padding:40px 20px;
  color:white;
}

.search-page h1{
  margin-bottom:30px;
  font-size:28px;
  line-height:1.4;
  word-break:break-word;
}

.grid{
  display:grid;
  grid-template-columns:
  repeat(auto-fill,minmax(180px,1fr));
  gap:20px;
}

.card{
  text-decoration:none;
  display:block;
}

.card img{
  width:100%;
  border-radius:10px;
  aspect-ratio:2/3;
  object-fit:cover;
}

.card h3{
  color:white;
  margin-top:10px;
  font-size:16px;
  line-height:1.4;
  min-height:44px;
}

.card p{
  color:#aaa;
  font-size:14px;
  line-height:1.4;
}

.empty{
  margin-top:30px;
}

.empty h2{
  line-height:1.5;
}

.maybe{
  margin-top:20px;
  margin-bottom:20px;
  color:#aaa;
}

.suggestions{
  display:flex;
  flex-direction:column;
  gap:12px;
}

.suggestion-item{
  display:flex;
  align-items:center;
  gap:12px;
  background:#161616;
  padding:10px;
  border-radius:10px;
  color:white;
  transition:.2s;
  text-decoration:none;
}

.suggestion-item:hover{
  background:#222;
}

.suggestion-item img{
  width:50px;
  height:75px;
  object-fit:cover;
  border-radius:6px;
}

.suggestion-content{
  flex:1;
  min-width:0;
}

.suggestion-content strong{
  display:block;
  line-height:1.4;
  word-break:break-word;
}

.suggestion-item p{
  color:#999;
  font-size:13px;
  margin-top:4px;
  line-height:1.4;
}

.home-btn{
  display:inline-block;
  margin-top:20px;
  padding:12px 20px;
  background:#e50914;
  color:white;
  border-radius:8px;
  font-weight:bold;
  text-decoration:none;
}

.home-btn:hover{
  opacity:.9;
}

@media(max-width:768px){

  .search-page{
    padding:20px 12px;
  }

  .search-page h1{
    font-size:22px;
  }

  .grid{
    grid-template-columns:
    repeat(2,1fr);
    gap:14px;
  }

  .card h3{
    font-size:14px;
    min-height:auto;
  }

  .card p{
    font-size:12px;
  }

  .suggestion-item{
    padding:8px;
  }

  .suggestion-item img{
    width:45px;
    height:68px;
  }

  .suggestion-content strong{
    font-size:14px;
  }

  .suggestion-item p{
    font-size:12px;
  }

}

</style>