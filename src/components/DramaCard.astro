---
const { drama } = Astro.props;
---

<a
  href={`/${drama.slug}/`}
  class="drama-card"
>

  <div class="poster-wrap">

    <img
      src={drama.poster}
      alt={drama.title}
      loading="lazy"
    />

  </div>

  <div class="card-content">

    <h3>
      {drama.title}
    </h3>

    <p class="year">
      {drama.year}
    </p>

  </div>

</a>

<style>
.drama-card{
  display:flex;
  flex-direction:column;
  height:100%;
  width:100%;
  text-decoration:none;
  color:white;
  background:#151515;
  border-radius:14px;
  overflow:hidden;
  transition:0.25s;
  border:1px solid #222;
}

/* hover lebih smooth */
.drama-card:hover{
  transform:translateY(-5px);
  border-color:#444;
}

/* FIX IMAGE AREA */
.poster-wrap{
  width:100%;
  aspect-ratio:2/3;
  overflow:hidden;
  background:#111;
  flex-shrink:0;
}

.poster-wrap img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  transition:0.3s;
}

.drama-card:hover img{
  transform:scale(1.05);
}

/* FIX CONTENT BIAR SERAGAM */
.card-content{
  padding:12px 12px 14px;
  display:flex;
  flex-direction:column;
  gap:6px;

  flex-grow:1;
}

/* TITLE */
.card-content h3{
  margin:0;
  font-size:15px;
  line-height:1.4;

  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden;

  min-height:42px; /* 🔥 ini penting supaya tinggi sama */
}

/* YEAR */
.year{
  margin:0;
  font-size:13px;
  color:#999;
}
</style>