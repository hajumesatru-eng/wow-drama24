---
const { drama } = Astro.props;

// 🔥 Safety fallback
const thaiTitle =
  drama?.title_th?.trim() || "";

const originalTitle =
  drama?.title?.trim() || "Untitled";

const displayTitle =
  thaiTitle || originalTitle;

const slug = drama?.slug || "#";
const poster = drama?.poster || "/no-image.png";
const year = drama?.year || "";
---

<a
  href={`/${slug}/`}
  class="drama-card"
>

  <div class="poster-wrap">

    <img
      src={poster}
      alt={originalTitle}
      loading="lazy"
    />

  </div>

  <div class="card-content">

    <h3 class="thai-title">
      {displayTitle}
    </h3>

    {thaiTitle && (
      <p class="original-title">
        ({originalTitle})
      </p>
    )}

    <p class="year">
      {year}
    </p>

  </div>

</a>

<style>
.drama-card{
  display:flex;
  flex-direction:column;
  height:100%;
  width:100%;
  text-decoration:none;
  color:white;
  background:#151515;
  border-radius:14px;
  overflow:hidden;
  transition:0.25s;
  border:1px solid #222;
}

/* hover lebih smooth */
.drama-card:hover{
  transform:translateY(-5px);
  border-color:#444;
}

/* FIX IMAGE AREA */
.poster-wrap{
  width:100%;
  aspect-ratio:2/3;
  overflow:hidden;
  background:#111;
  flex-shrink:0;
}

.poster-wrap img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  transition:0.3s;
}

.drama-card:hover img{
  transform:scale(1.05);
}

/* CONTENT */
.card-content{
  padding:12px 12px 14px;
  display:flex;
  flex-direction:column;
  gap:4px;
  flex-grow:1;
}

/* THAI TITLE */
.thai-title{
  margin:0;
  font-size:15px;
  line-height:1.4;
  font-weight:700;

  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden;

  min-height:42px;
}

/* ORIGINAL TITLE */
.original-title{
  margin:0;
  font-size:12px;
  color:#bdbdbd;
  line-height:1.4;

  display:-webkit-box;
  -webkit-line-clamp:1;
  -webkit-box-orient:vertical;
  overflow:hidden;
}

/* YEAR */
.year{
  margin:0;
  font-size:13px;
  color:#999;
}

/* MOBILE */
@media (max-width:768px){

  .thai-title{
    font-size:14px;
  }

  .original-title{
    font-size:11px;
  }

  .year{
    font-size:12px;
  }

}
</style>