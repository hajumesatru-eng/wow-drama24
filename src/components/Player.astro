---
const {
  servers = {},
  title = "Watch Online"
} = Astro.props;

const defaultServer =
  servers.vidlink ||
  servers.ezvid ||
  "";
---

<section class="player-wrapper">

  <h2 class="player-title">
    {title}
  </h2>

  <div class="server-buttons">

    {servers.vidlink && (
      <button
        type="button"
        class="server-btn active"
        data-server="vidlink"
      >
        VidLink
      </button>
    )}

    {servers.ezvid && (
      <button
        type="button"
        class="server-btn"
        data-server="ezvid"
      >
        EZVID
      </button>
    )}

  </div>

  <div class="player-box">

    <iframe
      id="video-player"
      src={defaultServer}
      title={title}
      loading="lazy"
      allowfullscreen
      frameborder="0"
      scrolling="no"
      referrerpolicy="origin"
      allow="autoplay; fullscreen; picture-in-picture"
    >
    </iframe>

  </div>

</section>

<script define:vars={{ servers }}>

const iframe = document.getElementById("video-player");

document.querySelectorAll(".server-btn").forEach((btn) => {

  btn.addEventListener("click", () => {

    const server = btn.dataset.server;

    if (!servers[server]) return;

    iframe.src = servers[server];

    document
      .querySelectorAll(".server-btn")
      .forEach((b) => b.classList.remove("active"));

    btn.classList.add("active");

  });

});

</script>

<style>

.player-wrapper{
  margin-top:20px;
}

.player-title{
  font-size:1.3rem;
  font-weight:700;
  margin-bottom:15px;
  line-height:1.5;
}

.server-buttons{
  display:flex;
  gap:10px;
  margin-bottom:15px;
  flex-wrap:wrap;
}

.server-btn{
  padding:10px 16px;
  border:none;
  border-radius:8px;
  background:#1f1f1f;
  color:#fff;
  cursor:pointer;
  transition:.2s;
}

.server-btn:hover{
  background:red;
}

.server-btn.active{
  background:red;
}

.player-box{
  width:100%;
  position:relative;
  overflow:hidden;
  border-radius:16px;
}

.player-box iframe{
  width:100%;
  border:none;
  border-radius:16px;
  aspect-ratio:16/9;
  min-height:300px;
}

/* TABLET */

@media (max-width:1024px){

  .player-box iframe{
    min-height:400px;
  }

}

/* MOBILE */

@media (max-width:768px){

  .player-title{
    font-size:1.05rem;
  }

  .server-buttons{
    gap:8px;
  }

  .server-btn{
    flex:1;
    min-width:110px;
    padding:10px;
  }

  .player-box iframe{
    min-height:220px;
  }

}

</style>