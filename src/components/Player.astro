---
const { servers, title } = Astro.props;
---

<div class="player-wrapper">

  <h2>{title}</h2>

  <div class="server-buttons">
    <button onclick="changeServer('vidlink')">
      VidLink
    </button>

    <button onclick="changeServer('ezvid')">
      EZVID
    </button>
  </div>

  <div class="player-box">
    <iframe
      id="video-player"
      src={servers.vidlink}
      allowfullscreen
      frameborder="0"
      scrolling="no"
      allow="autoplay; fullscreen"
    ></iframe>
  </div>

</div>

<script define:vars={{ servers }}>

function changeServer(server){

  document.getElementById("video-player").src =
    servers[server];

}

</script>

<style>

.player-wrapper{
  margin-top:20px;
}

.server-buttons{
  display:flex;
  gap:10px;
  margin-bottom:15px;
}

.server-buttons button{
  padding:10px 16px;
  border:none;
  border-radius:8px;
  background:#1f1f1f;
  color:white;
  cursor:pointer;
}

.server-buttons button:hover{
  background:red;
}

.player-box iframe{
  width:100%;
  height:600px;
  border:none;
  border-radius:16px;
}

</style>