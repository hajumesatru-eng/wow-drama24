---
import { categories } from '../data/categories';
---

<nav class="navbar">

  <div class="left">

    <!-- LOGO -->
    <a href="/" class="logo">
      WOW-DRAMA24
    </a>

    <!-- CATEGORY -->
    <div class="nav-links">

      {
        categories.map((category) => (

          <a
            href={`/category/${category.slug}/`}
            class="nav-item"
          >
            {category.name}
          </a>

        ))
      }

    </div>

  </div>

</nav>

<style>

.navbar{
  width:100%;
  height:70px;
  display:flex;
  align-items:center;
  padding:0 30px;
  background:#0b0b0b;
  border-bottom:1px solid #1c1c1c;
  position:sticky;
  top:0;
  z-index:9999;
}

.left{
  display:flex;
  align-items:center;
  gap:40px;
}

.logo{
  color:white;
  text-decoration:none;
  font-size:28px;
  font-weight:800;
  letter-spacing:1px;
  white-space:nowrap;
}

.nav-links{
  display:flex;
  align-items:center;
  gap:22px;
  flex-wrap:wrap;
}

.nav-item{
  color:#cfcfcf;
  text-decoration:none;
  font-size:15px;
  font-weight:500;
  transition:0.25s;
}

.nav-item:hover{
  color:#ffffff;
}

@media(max-width:768px){

  .navbar{
    height:auto;
    padding:15px;
  }

  .left{
    width:100%;
    flex-direction:column;
    align-items:flex-start;
    gap:15px;
  }

  .nav-links{
    gap:14px;
  }

  .logo{
    font-size:24px;
  }

}

</style>