<div class="search-box">

  <input
    id="searchInput"
    type="text"
    placeholder="ค้นหาซีรี่ย์..."
    autocomplete="off"
    aria-label="Search Drama"
  />

  <div
    id="searchResults"
    class="results"
    role="listbox"
  ></div>

</div>

<script is:inline>

const input = document.getElementById("searchInput");
const results = document.getElementById("searchResults");

let debounceTimer;

input.addEventListener("keydown", (e) => {

  if (e.key === "Enter") {

    const keyword = input.value.trim();

    if (!keyword) return;

    window.location.href =
      `/search?q=${encodeURIComponent(keyword)}`;
  }

});

input.addEventListener("input", () => {

  clearTimeout(debounceTimer);

  debounceTimer = setTimeout(async () => {

    const keyword =
      input.value.trim();

    results.innerHTML = "";

    if (!keyword) {
      results.style.display = "none";
      return;
    }

    try {

      const res = await fetch(
        `/api/search?q=${encodeURIComponent(keyword)}`
      );

      const dramas = await res.json();

      if (!dramas.length) {

        results.innerHTML = `
          <div class="no-result">
            ไม่พบซีรี่ย์
          </div>
        `;

        results.style.display = "block";
        return;
      }

      dramas.forEach((drama) => {

        const poster =
          drama.poster ||
          "https://placehold.co/50x75";

        results.innerHTML += `
          <a
            href="/drama/${drama.slug}"
            class="result-item"
          >

            <img
              src="${poster}"
              alt="${drama.title}"
              loading="lazy"
              width="50"
              height="75"
            />

            <div class="info">

              <h3>
                ${drama.title || ""}
              </h3>

              <p>
                ${drama.title_th || ""}
              </p>

            </div>

          </a>
        `;
      });

      results.style.display = "block";

    } catch (err) {

      console.error(err);

      results.innerHTML = `
        <div class="no-result">
          Search error
        </div>
      `;

      results.style.display = "block";
    }

  }, 300);

});

document.addEventListener("click", (e) => {

  if (!e.target.closest(".search-box")) {
    results.style.display = "none";
  }

});

document.addEventListener("keydown", (e) => {

  if (e.key === "Escape") {
    results.style.display = "none";
  }

});

</script>

<style>

.search-box{
  width:100%;
  max-width:700px;
  margin:30px auto;
  position:relative;
}

.search-box input{
  width:100%;
  height:58px;
  background:#1a1a1a;
  border:none;
  outline:none;
  border-radius:12px;
  padding:0 20px;
  color:white;
  font-size:16px;
  box-sizing:border-box;
}

.search-box input:focus{
  box-shadow:0 0 0 2px rgba(255,255,255,.1);
}

.results{
  position:absolute;
  top:70px;
  left:0;
  width:100%;

  max-height:450px;
  overflow-y:auto;

  background:#161616;
  border-radius:12px;

  display:none;
  z-index:99999;

  box-shadow:0 10px 30px rgba(0,0,0,.5);
}

.result-item{
  display:flex;
  align-items:center;
  gap:12px;
  padding:10px;
  border-bottom:1px solid #222;
  text-decoration:none;
}

.result-item:hover{
  background:#222;
}

.result-item img{
  width:50px;
  height:75px;
  min-width:50px;
  object-fit:cover;
  border-radius:6px;
  display:block;
}

.result-item .info{
  flex:1;
  overflow:hidden;
}

.result-item h3{
  margin:0;
  font-size:14px;
  line-height:1.4;
  color:#fff;

  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.result-item p{
  margin-top:4px;
  font-size:12px;
  line-height:1.4;
  color:#aaa;

  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.no-result{
  padding:20px;
  text-align:center;
  color:#999;
}

@media(max-width:768px){

  .search-box{
    margin:16px auto;
  }

  .search-box input{
    height:52px;
    font-size:14px;
    padding:0 16px;
  }

  .results{
    top:60px;
    max-height:320px;
  }

  .result-item{
    padding:10px;
    gap:10px;
  }

  .result-item img{
    width:46px;
    height:68px;
    min-width:46px;
  }

  .result-item h3{
    font-size:13px;
  }

  .result-item p{
    font-size:11px;
  }

}

</style>