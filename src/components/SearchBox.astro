---
import dramas from "../data/dramas.json";
---

<div class="search-box">

  <input
    id="searchInput"
    type="text"
    placeholder="ค้นหาซีรี่ย์..."
    autocomplete="off"
  />

  <div id="searchResults" class="results"></div>

</div>

<script define:vars={{ dramas }}>

const input = document.getElementById("searchInput");
const results = document.getElementById("searchResults");

// ENTER SEARCH
input.addEventListener("keydown", (e) => {

  if (e.key === "Enter") {

    const keyword = input.value.trim();

    if (!keyword) return;

    window.location.href =
      `/search?q=${encodeURIComponent(keyword)}`;
  }

});

// LIVE SEARCH
input.addEventListener("input", () => {

  const keyword = input.value.toLowerCase().trim();

  results.innerHTML = "";

  if (!keyword) {
    results.style.display = "none";
    return;
  }

  const filtered = dramas.filter((drama) => {

  const title =
    (drama.title || "").toLowerCase();

  const titleTh =
    (drama.title_th || "").toLowerCase();

  const words = title.split(" ");

  return (

    title.includes(keyword) ||

    titleTh.includes(keyword) ||

    words.some(word =>
      word.startsWith(keyword)
    )

  );

 });

  if (filtered.length === 0) {

    results.innerHTML = `
      <div class="no-result">
        ไม่พบซีรี่ย์
      </div>
    `;

    results.style.display = "block";
    return;
  }

  filtered.slice(0, 5).forEach((drama) => {

    results.innerHTML += `
      <a href="/${drama.slug}" class="result-item">

        <img
  src="${drama.poster}"
  alt="${drama.title}"
  style="
    width:50px;
    height:75px;
    min-width:50px;
    max-width:50px;
    object-fit:cover;
    border-radius:6px;
  "
/>

        <div class="info">
          <h3>${drama.title}</h3>
          <p>${drama.title_th || ""}</p>
        </div>

      </a>
    `;

  });

  results.style.display = "block";

});

// CLICK OUTSIDE
document.addEventListener("click", (e) => {

  if (!e.target.closest(".search-box")) {
    results.style.display = "none";
  }

});

</script>

<style>

.search-box{
  width:100%;
  max-width:700px;
  margin:30px auto;
  position:relative;
}

.search-box input{
  width:100%;
  height:58px;
  background:#1a1a1a;
  border:none;
  outline:none;
  border-radius:12px;
  padding:0 20px;
  color:white;
  font-size:16px;
}

.results{
  position:absolute;
  top:70px;
  left:0;
  width:100%;

  max-height:450px;
  overflow-y:auto;

  background:#161616;
  border-radius:12px;

  display:none;
  z-index:99999;

  box-shadow:0 10px 30px rgba(0,0,0,.5);
}

.result-item{
  display:flex;
  align-items:center;
  gap:12px;
  padding:10px;
  border-bottom:1px solid #222;
  text-decoration:none;
}

.result-item:hover{
  background:#222;
}

.result-item img{
  width:50px !important;
  height:75px !important;
  min-width:50px !important;
  max-width:50px !important;

  object-fit:cover;
  border-radius:6px;
  display:block;
}

.result-item .info{
  flex:1;
  overflow:hidden;
}

.result-item h3{
  margin:0;
  font-size:14px;
  color:#fff;
}

.result-item p{
  margin-top:4px;
  font-size:12px;
  color:#aaa;
}

.no-result{
  padding:20px;
  text-align:center;
  color:#999;
}

@media(max-width:768px){

  .results{
    top:65px;
  }

  .result-item img{
    width:50px !important;
    height:75px !important;
  }

}

</style>